# Copy to .env for local work. NEVER commit .env. In production set these as environment
# variables on the host (see DEPLOY.md). Every value here is a harmless placeholder.

APP_NAME=OCCDL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Alerts: LOG_SECURITY_STACK=security_stderr,security_slack  +  LOG_SECURITY_WEBHOOK_URL=
LOG_SECURITY_STACK=security_stderr
LOG_SECURITY_WEBHOOK_URL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=occdl
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Web Push: generate ONCE with `php artisan webpush:vapid --show`, then never change.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OCCDL switches
OCC_TIMEZONE=Asia/Manila
OCC_MOBILE_ONLY=true
OCC_INSPECT_PROTECTION=true
OCC_CSP_ENFORCE=true
OCC_FORCE_HTTPS=true
OCC_TRUSTED_PROXIES=*
OCC_ROSTER_ENFORCE=true
OCC_ALERT_FAILURES=20
OCC_ALERT_WINDOW_MIN=10
