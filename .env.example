APP_NAME="OCCDL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sign-in = a server-side session: an HttpOnly cookie + one row per device in the `sessions`
# table. JavaScript never sees a token. Run `php artisan migrate` to create the table.
SESSION_DRIVER=database
SESSION_LIFETIME=43200          # idle minutes a row is kept (must cover OCC_SESSION_REMEMBER_DAYS)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# Production (HTTPS): leave unset -> cookie is Secure + __Host- prefixed automatically.
# Set false ONLY for plain-HTTP local development.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Phone-only switch --------------------------------------------------------
# true  = the app opens only on a real phone (installed PWA / phone browser).
# false = the app opens on every device (normal responsive website).
# After changing it run: php artisan config:clear   (no rebuild needed)
OCC_MOBILE_ONLY=true

# --- DevTools / inspect protection ---------------------------------------------
# true  = the app hides itself while browser DevTools is open (also DevTools
#         "device mode"), and blocks F12 / Ctrl+Shift+I / Ctrl+U / right-click.
# false = protection off. Use false while you develop and debug.
# Production: set true. After changing it run: php artisan config:clear (no rebuild needed)
OCC_INSPECT_PROTECTION=false

# Sign-in lifetime
OCC_SESSION_HOURS=12
OCC_SESSION_REMEMBER_DAYS=30
