* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Shell scripts must keep LF line endings (Windows checkouts break them inside Linux containers).
*.sh text eol=lf
Dockerfile text eol=lf
