<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database"/>
        <!-- Your real .env holds INITIAL_ADMIN_*; blank them so tests never seed an admin by accident. -->
        <env name="INITIAL_ADMIN_NAME" value=""/>
        <env name="INITIAL_ADMIN_EMAIL" value=""/>
        <env name="INITIAL_ADMIN_PASSWORD" value=""/>
        <env name="INITIAL_ADMIN_ID" value=""/>
        <!-- Pin the OCC switches so a .env copied from .env.example cannot change test outcomes. -->
        <env name="OCC_FORCE_HTTPS" value="false"/>
        <env name="OCC_CSP_ENFORCE" value="false"/>
        <env name="OCC_ROSTER_ENFORCE" value="false"/>
        <env name="OCC_REGISTRATION_APPROVAL" value="false"/>
        <env name="OCC_2FA_REQUIRED" value="false"/>
        <env name="OCC_TRUSTED_PROXIES" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
